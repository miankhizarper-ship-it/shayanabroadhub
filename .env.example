# ─────────────────────────────────────────────────────────────
# ShayanaBroadhub — environment template
# Copy to `.env` (local) or configure in Vercel → Settings →
# Environment Variables. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite) ──────────────────────────────────────────
# Variables exposed to the client MUST be prefixed with VITE_.
VITE_SITE_URL=http://localhost:3000

# ── Database (server-side only) ──────────────────────────────
# MongoDB Atlas connection string.
MONGODB_URI=

# ── Admin authentication (server-side only) ──────────────────
# Long random string (e.g. `openssl rand -base64 48`).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used ONLY by the manual seed script (bun run seed:admin).
# Never committed; in production the script additionally
# requires ALLOW_ADMIN_SEED=true.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ALLOW_ADMIN_SEED=true

# ── Cloudinary media (server-side only) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Deployment ───────────────────────────────────────────────
# Comma-separated allowlist of browser origins for CORS.
CLIENT_URL=http://localhost:3000
NODE_ENV=development
